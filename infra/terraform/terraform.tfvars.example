# ATALAYA // Copiá a terraform.tfvars si necesitás cambiar algo.
# Los valores por defecto ya apuntan a gonzalodiascenzi/atalaya.

region      = "us-east-1"
environment = "prod"

# Identidad de GitHub para el rol de despliegue (sujeto OIDC inmutable).
#   gh api repos/DUEÑO/REPO --jq '.owner.id, .id'
github_owner    = "gonzalodiascenzi"
github_repo     = "atalaya"
github_owner_id = 88945030
github_repo_id  = 1365053110

lambda_memory_mb   = 1024
log_retention_days = 14
