# ══════════════════════════════════════════════════════════════════════
#  ATALAYA // Plantilla de entorno
#  ---------------------------------------------------------------------
#  1. cp .env.example .env
#  2. Reemplazá TODOS los valores marcados con <<CAMBIAR>>.
#  3. Generá secretos reales, no inventes strings a mano:
#       openssl rand -hex 32          -> claves / salts
#       uuidgen                       -> tokens de OpenCTI (deben ser UUIDv4)
#       openssl rand -base64 24       -> passwords de servicios
#  4. `.env` está en .gitignore. Si alguna vez lo commiteás: rotá todo.
# ══════════════════════════════════════════════════════════════════════

# ─── Identidad del despliegue ─────────────────────────────────────────
ATALAYA_ENV=local                      # local | staging | prod
ATALAYA_BASE_DOMAIN=atalaya.localhost
TZ=America/Argentina/Buenos_Aires

# ─── API de gamificación (FastAPI) ────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
API_LOG_LEVEL=info                     # critical|error|warning|info|debug
API_WORKERS=2
# Clave para firmar sesiones/JWT de analistas. 32 bytes hex mínimo.
API_SECRET_KEY=<<CAMBIAR>>__openssl_rand_hex_32
# Orígenes permitidos por CORS, separados por coma (sin espacios).
API_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Cuántas misiones devuelve cada página del feed infinito.
API_FEED_PAGE_SIZE=20
# Límite de peticiones por IP y ventana. Ojo con las aulas detrás de un NAT:
# ahí todos comparten IP pública y un techo bajo castiga al grupo entero.
API_RATE_LIMIT=120
API_RATE_WINDOW=60

# ─── Frontend (Next.js) ───────────────────────────────────────────────
# Se expone al navegador: NUNCA pongas secretos en variables NEXT_PUBLIC_*.
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_CALLSIGN=gon               # indicativo del analista por defecto
NEXT_PUBLIC_BUILD_CHANNEL=dev

# ─── PostgreSQL (perfiles de analistas, XP, progreso) ─────────────────
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=atalaya
POSTGRES_USER=atalaya
POSTGRES_PASSWORD=<<CAMBIAR>>__openssl_rand_base64_24
# DSN para las herramientas que corren EN TU MÁQUINA: alembic, uvicorn en
# modo desarrollo, un cliente SQL. Por eso dice `localhost` y no `postgres`.
# Los contenedores NO usan esta variable: docker-compose.yml arma su propio
# DSN apuntando al host interno `postgres`. Son dos contextos de red.
DATABASE_URL=postgresql+asyncpg://atalaya:<<CAMBIAR>>@localhost:5432/atalaya

# ─── OpenCTI (correlación y grafo STIX 2.1) ───────────────────────────
# OJO: OPENCTI_ADMIN_TOKEN debe ser un UUIDv4 válido -> uuidgen
OPENCTI_URL=http://opencti:8080
OPENCTI_PORT=8080
OPENCTI_BASE_URL=http://localhost:8080
OPENCTI_ADMIN_EMAIL=admin@atalaya.localhost
OPENCTI_ADMIN_PASSWORD=<<CAMBIAR>>__openssl_rand_base64_24
OPENCTI_ADMIN_TOKEN=00000000-0000-4000-a000-000000000000
OPENCTI_HEALTHCHECK_ACCESS_KEY=<<CAMBIAR>>__openssl_rand_hex_16
# Token del conector de ingesta (distinto del admin, principio de mínimo privilegio)
CONNECTOR_ATALAYA_ID=00000000-0000-4000-a000-000000000001
CONNECTOR_LOG_LEVEL=info

# ─── Dependencias de OpenCTI ──────────────────────────────────────────
ELASTIC_MEMORY_SIZE=2G
ELASTICSEARCH_URL=http://elasticsearch:9200
REDIS_URL=redis://redis:6379
MINIO_ENDPOINT=minio
MINIO_PORT=9000
MINIO_ROOT_USER=atalaya-minio
MINIO_ROOT_PASSWORD=<<CAMBIAR>>__openssl_rand_base64_24
RABBITMQ_DEFAULT_USER=atalaya-mq
RABBITMQ_DEFAULT_PASS=<<CAMBIAR>>__openssl_rand_base64_24
SMTP_HOSTNAME=localhost

# ─── MISP (compartición de IoCs) ──────────────────────────────────────
MISP_BASEURL=https://localhost:8443
MISP_HTTPS_PORT=8443
MISP_ADMIN_EMAIL=admin@atalaya.localhost
MISP_ADMIN_PASSWORD=<<CAMBIAR>>__openssl_rand_base64_24
# La API key se genera DESDE la UI de MISP (Administration > List Auth Keys)
MISP_API_KEY=<<CAMBIAR>>__generar_en_la_ui_de_misp
MISP_VERIFY_SSL=false                  # false SOLO en local (cert autofirmado)
MYSQL_HOST=misp-db
MYSQL_DATABASE=misp
MYSQL_USER=misp
MYSQL_PASSWORD=<<CAMBIAR>>__openssl_rand_base64_24
MYSQL_ROOT_PASSWORD=<<CAMBIAR>>__openssl_rand_base64_24

# ─── Fuentes OSINT de ingesta ─────────────────────────────────────────
# AlienVault OTX -> https://otx.alienvault.com/api
OTX_API_KEY=<<CAMBIAR>>__64_hex_chars_de_tu_cuenta_otx
OTX_PULSE_LIMIT=50
# abuse.ch (ThreatFox / URLhaus / MalwareBazaar) -> requiere Auth-Key desde 2024
ABUSECH_AUTH_KEY=<<CAMBIAR>>__auth_key_de_abuse_ch
THREATFOX_API_URL=https://threatfox-api.abuse.ch/api/v1/
URLHAUS_API_URL=https://urlhaus-api.abuse.ch/v1/
# CISA KEV: catálogo público, sin API key.
CISA_KEV_URL=https://www.cisa.gov/sites/default/files/feeds/known_exploited_vulnerabilities.json
# SpiderFoot (instancia local)
SPIDERFOOT_URL=http://spiderfoot:5001
SPIDERFOOT_API_KEY=<<CAMBIAR>>__si_habilitaste_auth

# ─── Ritmo de ingesta ─────────────────────────────────────────────────
INGEST_INTERVAL_MINUTES=15
# Dónde cachear el catálogo KEV (1,7 MB). Vacío = temporal del sistema.
INGEST_CACHE_DIR=
INGEST_MAX_IOCS_PER_RUN=500
# TLP por defecto para lo que publicamos hacia la plataforma.
DEFAULT_TLP=TLP:CLEAR

# ─── Gamificación (umbrales de XP por rango) ──────────────────────────
XP_NOVATO=0
XP_ANALISTA_JUNIOR=250
XP_ANALISTA_SENIOR=1200
XP_CAZADOR_DE_AMENAZAS=4000
