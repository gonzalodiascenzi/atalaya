# ─────────────────────────────────────────────────────────────
#  ATALAYA // .gitignore
#  Regla de oro: si tiene un secreto adentro, no entra al repo.
# ─────────────────────────────────────────────────────────────

# ── Secretos y entorno ───────────────────────────────────────
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
*.crt
!**/testdata/*.crt
secrets/
credentials.json
*.kdbx

# ── Python ───────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib60/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST
venv/
.venv/
env/
ENV/
.python-version
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml
*.cover
.tox/
.hypothesis/

# ── Node / Next.js ───────────────────────────────────────────
node_modules/
.pnp
.pnp.js
.yarn/install-state.gz
.next/
out/
build/
.turbo/
next-env.d.ts
*.tsbuildinfo
.npm
.eslintcache
.pnpm-debug.log*
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ── Terraform ────────────────────────────────────────────────
**/.terraform/*
# .terraform.lock.hcl SÍ se commitea: fija versiones y hashes de los providers,
# igual que package-lock.json. Ignorarlo deja la puerta abierta a que cada
# `init` traiga un provider distinto.
!.terraform.lock.hcl
*.tfstate
*.tfstate.*
*.tfvars
!*.tfvars.example
crash.log
crash.*.log
override.tf
override.tf.json
*_override.tf
*_override.tf.json
.terraformrc
terraform.rc
tfplan
*.tfplan

# ── Docker / datos persistentes ──────────────────────────────
deployments/docker/data/
deployments/docker/volumes/
*.tar.gz

# ── Inteligencia cruda / artefactos de ingesta ───────────────
# Nunca commitear feeds crudos ni muestras de malware.
data/raw/
data/staging/
*.stix.json
!docs/samples/*.stix.json
samples/malware/
*.pcap

# ── IDE / SO ─────────────────────────────────────────────────
.vscode/
!.vscode/extensions.json
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
desktop.ini

# ── Reportes de seguridad generados en CI ────────────────────
trivy-results.sarif
gitleaks-report.json
bandit-report.json
